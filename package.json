{
  "name": "mapexplorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "Nils Witt",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@vis.gl/react-maplibre": "^8.1.2",
    "csv": "^6.6.3",
    "maplibre-gl": "^6.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
