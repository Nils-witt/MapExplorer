# Copy this file to .env and adjust values for local development.
# All variables must be prefixed with VITE_ to be exposed to client code.
# Map styles, servers and the OIDC provider come from /config.json (see
# config.example.json), in dev mode as in builds.

# Map style URL used when config.json lists no mapStyles.
# VITE_DEFAULT_STYLE_URL=https://demotiles.maplibre.org/style.json

# Dev server only: proxy /config.json to this URL instead of expecting a local
# public/config.json. Not exposed to client code. The servers it lists must
# allow the dev origin (http://localhost:5173), e.g. in a unit server's
# CORS_ALLOWED_ORIGINS, and the OIDC provider must allow
# http://localhost:5173/login/callback as a redirect URI.
# DEV_CONFIG_JSON_URL=https://maps.example.com/config.json
