# Copy this file to .env and adjust values for local development overrides.
# All variables must be prefixed with VITE_ to be exposed to client code.

# Default map style URL loaded on startup.
# VITE_DEFAULT_STYLE_URL=https://demotiles.maplibre.org/style.json

# Dev server only: an overlay server (tileserve-go) and a unit server
# (go-unit-mangement) that are always connected, besides those added in the
# settings. The names default to the host. Builds read them from config.json
# instead (defaultOverlaysServer[Name], defaultUnitsServer[Name]). The unit server must list the dev
# origin (http://localhost:5173) in its CORS_ALLOWED_ORIGINS.
# VITE_OVERLAY_SERVER_URL=https://overlays.example.com
# VITE_OVERLAY_SERVER_NAME=Overlays
# VITE_UNIT_SERVER_URL=http://localhost:8080
# VITE_UNIT_SERVER_NAME=Units

# Dev server only: proxy /config.json to this URL instead of expecting a local
# public/config.json. Not exposed to client code.
# DEV_CONFIG_JSON_URL=https://maps.example.com/config.json
